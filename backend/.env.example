# ─── Database ─────────────────────────────────────────────────────────────────
# Matches the docker-compose.yml defaults — change for production
DATABASE_URL=postgresql://rbac_user:rbac_password@localhost:5432/rbac_marketplace

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# ─── Authentication ───────────────────────────────────────────────────────────
# Must be at least 32 characters in production — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
