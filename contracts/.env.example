# ─── Wallet ───────────────────────────────────────────────────────────────────
# NEVER commit a real private key. Use a dedicated deployer wallet with minimal funds.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
LOCALHOST_RPC_URL=http://127.0.0.1:8545
# Get a free key at https://app.infura.io or https://dashboard.alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Infura project ID (used in SEPOLIA_RPC_URL above)
INFURA_API_KEY=YOUR_INFURA_PROJECT_ID
# Etherscan key for contract verification — https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# ─── Target Network ───────────────────────────────────────────────────────────
# Options: localhost | sepolia
NETWORK=localhost
