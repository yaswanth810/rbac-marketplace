# ─── Test database ─────────────────────────────────────────────────────────────
# Use a SEPARATE database from development to avoid data corruption.
#
# Create it first (run once):
#   docker exec -it rbac_marketplace_db psql -U rbac_user -c "CREATE DATABASE rbac_marketplace_test;"
#
# Then apply migrations against it (one-time setup):
#   cd database
#   cp .env.example .env
#   # Edit .env: change DATABASE_URL to point at rbac_marketplace_test
#   npx tsx migrate.ts
#   npx tsx seed.ts
#   # Restore .env DATABASE_URL to development DB when done

TEST_DATABASE_URL=postgresql://rbac_user:rbac_password@localhost:5432/rbac_marketplace_test

# ─── JWT (overridden by vitest.config.ts — keep in sync) ──────────────────────
JWT_SECRET=test_jwt_secret_for_rbac_tests_32char
